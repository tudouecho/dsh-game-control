// dsh-game-control 技能配置文件（JSONC：支持 // 行注释与 /* */ 块注释）
// 标题：Keep on Mining 挖矿循环（等按钮→点击→30s圆形）
// 适用游戏：Keep on Mining!
// 说明：激活游戏窗口，等「开始挖矿！」按钮出现（兼容完成面板与准备界面两种样式，最多 20 秒），点击进入下一轮，等 2 秒后在窗口中心以半径 360px 画圆 30 秒；运行中按 Esc 可随时中止。不再要求先出现「挖矿已完成」面板。
// 生成时间：2026-11-08T11:44:45.950Z
// 步骤数：5
// 保存时自动补全每步参数并重新生成中文注释；手工修改注释会被覆盖，自定义备注请写 note 字段。
// 直接编辑本文件后，下一次 skill_get / skill_run 生效（也可在面板「技能库 → 完整配置文件」编辑）。
{
  "schema": 1,
  "id": "keep-on-mining-30s",
  "title": "Keep on Mining 挖矿循环（等按钮→点击→30s圆形）",
  "description": "激活游戏窗口，等「开始挖矿！」按钮出现（兼容完成面板与准备界面两种样式，最多 20 秒），点击进入下一轮，等 2 秒后在窗口中心以半径 360px 画圆 30 秒；运行中按 Esc 可随时中止。不再要求先出现「挖矿已完成」面板。",
  "game": "Keep on Mining!",
  "tags": ["mining", "loop", "auto", "esc"],
  "markdown": "## 前置条件\n\n- 游戏《Keep on Mining!》已启动，窗口未最小化（可在后台；第 1 步会激活窗口）。\n- 模板位于 `<GAME_CONTROL_HOME>/templates/keep-on-mining/`：\n  - `next_round.png`：完成面板里的「开始挖矿！」按钮文字\n  - `start_mining.png`：准备界面右下角的「开始挖矿！」按钮文字\n- 两个模板任一出现即视为按钮可用（`templates` 多模板），不要求先看到「挖矿已完成」标题。\n\n## 执行逻辑\n\n1. `activate_window`：把游戏切到前台（否则键鼠会打到 DSH 窗口）。\n2. `wait_image`：最多等 20 秒，任一「开始挖矿！」按钮出现即返回（`$btn.match.center` 为按钮中心）。\n3. `mouse_click`：点击按钮中心，进入下一轮。\n4. `wait(2000)`：等转场。\n5. `mouse_circle`：圆心=窗口客户区中心、半径 360px、30 秒（约 12 圈）、顺时针；传 hwnd 做前台校验；**Esc 中止**。\n\n## 中止与重复\n\n- 运行中按 **Esc** 立即停止（等待模板阶段也生效），鼠标键会自动释放。\n- `skill_run {id, repeat: N}` 可连续刷 N 轮；每轮约 35 秒。\n\n## 注意\n\n- 模板对窗口分辨率/DPI 变化敏感；换分辨率后需重新裁剪。\n- 保存时会自动补全每步参数并重新生成中文注释；自定义备注写在步骤的 `note` 字段。\n",
  "steps": [
    // 第 1 步：激活窗口 —— 前置窗口（标题包含“Keep on Mining”，恢复最小化=true，超时 2000ms）；无额外等待
    {
      "action": "activate_window",
      "params": {
        "window": "Keep on Mining",
        "restore": true,
        "timeoutMs": 2000
      },
      "waitMs": 0,
      "continueOnError": false
    },
    // 第 2 步：等待模板 —— 在 窗口“Keep on Mining”的 clientRect 等待多模板 [keep-on-mining/next_round.png, keep-on-mining/start_mining.png]（中止键 esc） 出现（超时 20000ms，间隔 250ms，阈值 0.85，缩小搜索=[1.0]）；无额外等待；结果保存为 btn
    {
      "action": "wait_image",
      "params": {
        "templates": [
          "keep-on-mining/next_round.png",
          "keep-on-mining/start_mining.png"
        ],
        "window": "Keep on Mining",
        "timeoutMs": 20000,
        "intervalMs": 250,
        "threshold": 0.85,
        "grayscale": true,
        "maxResults": 3,
        "scales": [
          1.0
        ],
        "mode": "appear",
        "abortKey": "esc"
      },
      "waitMs": 0,
      "continueOnError": false,
      "saveAs": "btn"
    },
    // 第 3 步：鼠标点击 —— 在 ($btn.match.center.x, $btn.match.center.y) 点击 1 次（左键，间隔 60ms）；无额外等待
    {
      "action": "mouse_click",
      "params": {
        "x": "$btn.match.center.x",
        "y": "$btn.match.center.y",
        "clicks": 1,
        "button": "left",
        "intervalMs": 60
      },
      "waitMs": 0,
      "continueOnError": false
    },
    // 第 4 步：等待 —— 等待 2000ms；无额外等待
    {
      "action": "wait",
      "params": {
        "durationMs": 2000
      },
      "waitMs": 0,
      "continueOnError": false
    },
    // 第 5 步：圆形轨迹 —— 以 ($window.clientCenterX, $window.clientCenterY) 为圆心、半径 360px 画圆 30000ms（周期 2500ms，顺时针，120Hz，按住 无，中止键 esc）；无额外等待
    {
      "action": "mouse_circle",
      "params": {
        "centerX": "$window.clientCenterX",
        "centerY": "$window.clientCenterY",
        "radius": 360,
        "periodMs": 2500,
        "durationMs": 30000,
        "direction": "cw",
        "hwnd": "$window.hwnd",
        "abortKey": "esc",
        "startAngleDeg": -90,
        "samplesPerSecond": 120,
        "leadInMs": 300,
        "button": "none"
      },
      "waitMs": 0,
      "continueOnError": false
    }
  ],
  "createdAt": "2026-11-08T10:42:43.211Z",
  "updatedAt": "2026-11-08T11:44:45.950Z"
}
